# Copy to .env and fill in real values. .env is gitignored — NEVER commit it.
# The .env file is the ONLY place a real key belongs.

# Anthropic API key with access to BOTH Opus (claude-opus-4-8)
# and Haiku (claude-haiku-4-5-20251001). Required for live reconciliation.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Fixed "today" (ISO-8601) used for overdue calculations so the demo
# is reproducible. If unset, the current system date is used.
# SAFETY_NET_AS_OF_DATE=2026-07-18
